# agents7 UI — environment variables
#
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored; this template is committed. Never commit secrets.
# The docker-compose backend service loads it (env_file: agents7_ui/.env).
#
# Values already set in docker-compose.yml `environment:` win over this
# file, so the entries below are mainly for secrets and local overrides.

# ── Ollama ──────────────────────────────────────────────────────────────
# Where the backend reaches Ollama.
#   Native (no Docker): leave as the default http://localhost:11434.
#   Docker Compose: host.docker.internal:11434 — but the host Ollama must
#   then bind a docker-reachable address (it binds localhost by default,
#   which containers cannot reach). See README.md.
# OLLAMA_HOST=http://localhost:11434

# Allow POST /api/engine/start to spawn a local `ollama serve` (1/true/yes/on).
# Only meaningful when the backend runs on a host that has the `ollama` binary
# and OLLAMA_HOST points at localhost. Off by default; not used by the Docker
# stack (which relies on the host's own Ollama service).
# ALLOW_ENGINE_START=1

# Default Ollama model used only when code falls back to OllamaSettings.
# Catalog agents set their own model in YAML, so usually leave unset.
# OLLAMA_MODEL_NAME=qwen3

# ── Ports ───────────────────────────────────────────────────────────────
# Published host port for the frontend (nginx) in the compose stack.
# Defaults to 5185, a registry-claimed port — never the shared 8080 default.
# The CORS_ORIGINS default and the startup banner both follow this value.
# FRONTEND_PORT=5185

# ── HTTP / CORS ─────────────────────────────────────────────────────────
# Comma-separated allowed browser origins. Only needed when the UI is served
# from a different origin than the API. In the compose stack the browser hits
# /api same-origin via nginx, so the default already covers it.
# CORS_ORIGINS=http://localhost:5185

# ── Auth (SECRET) ───────────────────────────────────────────────────────
# If set, every endpoint except /api/health and /api/engine/status requires
# `Authorization: Bearer <API_KEY>`.
#
# CAVEAT: the bundled frontend does NOT send this header, so setting API_KEY
# will 401 the entire UI. For an exposed deployment put an external auth layer
# (nginx basic-auth, oauth2-proxy, …) in front instead. Leave unset for local
# or otherwise-trusted use.
# API_KEY=

# ── LLM provider keys (SECRET) ──────────────────────────────────────────
# Only needed if you add an agent using a non-Ollama provider. The catalog
# ships all-Ollama, so these are unset by default.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
#
# External OpenAI-compatible provider (e.g. DeepSeek). An openai_compat
# engine with no explicit model/url/key falls back to these three.
# OPENAI_COMPAT_MODEL_NAME=deepseek-chat
# OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
# OPENAI_COMPAT_API_KEY=

# ── Tuning ──────────────────────────────────────────────────────────────
# Max concurrent LLM requests in batch processing (default 5).
# BATCH_MAX_CONCURRENT=5

# Catalog location inside the container (set in the Dockerfile; rarely
# overridden).
# CATALOG_PATH=/app/agents_catalog
