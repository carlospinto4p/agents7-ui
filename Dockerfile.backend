# Build context: repo root
# docker build -f agents7_ui/Dockerfile.backend .
FROM python:3.12-slim

RUN pip install --no-cache-dir uv

# Bundle the Ollama runtime so the backend can start it on demand
# (POST /api/engine/start, gated by ALLOW_ENGINE_START). CPU works out
# of the box; GPU additionally needs the host's NVIDIA container
# toolkit and a device reservation (see docker-compose.yml).
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates zstd \
    && curl -fsSL https://ollama.com/install.sh | sh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY agents7_framework/pyproject.toml agents7_framework/README.md agents7_framework/
COPY agents7_framework/src agents7_framework/src/

RUN uv pip install --system agents7_framework/

# Install backend API deps (no private index needed)
RUN uv pip install --system "fastapi>=0.115.0" "uvicorn[standard]>=0.34.0" "pyyaml>=6.0" "httpx>=0.28.0"

COPY agents_catalog/ agents_catalog/
COPY agents7_ui/backend/ backend/

ENV CATALOG_PATH=/app/agents_catalog

WORKDIR /app/backend

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
