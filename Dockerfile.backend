# Build context: repo root
# docker build -f agents7_ui/Dockerfile.backend .
FROM python:3.12-slim

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY agents7_framework/pyproject.toml agents7_framework/README.md agents7_framework/
COPY agents7_framework/src agents7_framework/src/

RUN uv pip install --system agents7_framework/

# Install backend API deps (no private index needed)
RUN uv pip install --system "fastapi>=0.115.0" "uvicorn[standard]>=0.34.0" "pyyaml>=6.0" "httpx>=0.28.0"

COPY agents_catalog/ agents_catalog/

# Catalog agents that ship as installable packages (e.g. a custom
# output_model like tagger_agent.models.NickTag) must be importable by
# their dotted path at run time, or POST /api/run/<agent> fails with
# ModuleNotFoundError. Install each package with --no-deps (agents7 is
# already installed from a local path and is not on PyPI), then install
# their third-party runtime deps.
RUN for d in agents_catalog/*/; do \
        if [ -f "${d}pyproject.toml" ]; then \
            uv pip install --system --no-deps "$d"; \
        fi; \
    done
RUN uv pip install --system "rapidfuzz>=3.0.0"

COPY agents7_ui/backend/ backend/

ENV CATALOG_PATH=/app/agents_catalog

WORKDIR /app/backend

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
